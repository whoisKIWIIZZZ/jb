HIST_LEN = 180  # 采样点数 (默认 2s 一次, 约 6 分钟)


def _num(x):
    try:
        return float(x)
    except ValueError:
        return None


def proc_info(pid):
    info = {"pid": pid, "user": "?", "cmd": "", "sid": None, "pgrp": None}
    try:
        with open(f"/proc/{pid}/stat") as f:
            rest = f.read().rsplit(")", 1)[1].split()
        info["pgrp"], info["sid"] = int(rest[2]), int(rest[3])
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            cmd = f.read().replace(b"\0", b" ").decode(errors="replace").strip()
        info["cmd"] = cmd.replace(os.path.expanduser("~"), "~")[:400]
        with open(f"/proc/{pid}/status") as f:
            for line in f:
                if line.startswith("Uid:"):
                    info["user"] = pwd.getpwuid(int(line.split()[1])).pw_name
                    break
    except (FileNotFoundError, ProcessLookupError, PermissionError, KeyError, IndexError, ValueError):
        pass
    return info


def query_gpus(job_pids):
    fields = "index,uuid,name,utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw,power.limit,fan.speed"
    out = subprocess.run(["nvidia-smi", f"--query-gpu={fields}", "--format=csv,noheader,nounits"],
                         capture_output=True, text=True, timeout=10).stdout
    gpus, by_uuid = [], {}
    for line in out.strip().splitlines():
        p = [x.strip() for x in line.split(",")]
        g = {"index": p[0], "name": p[2], "util": _num(p[3]), "mem_used": _num(p[4]), "mem_total": _num(p[5]),
             "temp": _num(p[6]), "power": _num(p[7]), "power_limit": _num(p[8]), "fan": _num(p[9]), "procs": []}
        g["mem_pct"] = 100 * g["mem_used"] / g["mem_total"] if g["mem_used"] is not None and g["mem_total"] else None
        gpus.append(g)
        by_uuid[p[1]] = g
    out = subprocess.run(["nvidia-smi", "--query-compute-apps=gpu_uuid,pid,used_memory", "--format=csv,noheader,nounits"],
                         capture_output=True, text=True, timeout=10).stdout
    for line in out.strip().splitlines():
        p = [x.strip() for x in line.split(",")]
        if len(p) < 3 or p[0] not in by_uuid:
            continue
        info = proc_info(int(p[1]))
        info["mem"] = _num(p[2])
        info["job"] = job_pids.get(info["sid"]) or job_pids.get(info["pgrp"])
        by_uuid[p[0]]["procs"].append(info)
    for g in gpus:
        g["procs"].sort(key=lambda x: -(x["mem"] or 0))
    return gpus


def host_info():
    mem = {}
    with open("/proc/meminfo") as f:
        for line in f:
            k, v = line.split(":", 1)
            mem[k] = int(v.split()[0]) * 1024
    with open("/proc/uptime") as f:
        uptime = float(f.read().split()[0])
    disk = shutil.disk_usage(os.path.expanduser("~"))
    return {
        "hostname": socket.gethostname(), "ncpu": os.cpu_count(), "load": os.getloadavg(), "uptime": uptime,
        "mem_total": mem["MemTotal"], "mem_used": mem["MemTotal"] - mem.get("MemAvailable", mem["MemFree"]),
        "disk_total": disk.total, "disk_used": disk.used,
    }


class Sampler(threading.Thread):
    def __init__(self, interval):
        super().__init__(daemon=True)
        self.interval = interval
        self.lock = threading.Lock()
        self.state = {}
        self.hist = {}
        self.host_hist = deque(maxlen=HIST_LEN)
        self._cpu_prev = None

    def _cpu_pct(self):
        with open("/proc/stat") as f:
            vals = list(map(int, f.readline().split()[1:9]))
        idle, total = vals[3] + vals[4], sum(vals)
        prev, self._cpu_prev = self._cpu_prev, (idle, total)
        if not prev or total == prev[1]:
            return None
        return 100 * (1 - (idle - prev[0]) / (total - prev[1]))

    def sample(self):
        now = time.time()
        job_pids = {}
        for jid in all_ids():
            m = read_json(os.path.join(jdir(jid), "meta.json"))
            if m and m.get("child_pid") and "end" not in m:
                job_pids[m["child_pid"]] = {"id": jid, "name": m.get("name")}
        try:
            gpus, err = query_gpus(job_pids), None
        except Exception as e:
            gpus, err = [], f"nvidia-smi: {e}"
        host = host_info()
        host["cpu"] = self._cpu_pct()
        host["mem_pct"] = 100 * host["mem_used"] / host["mem_total"]
        for g in gpus:
            self.hist.setdefault(g["index"], deque(maxlen=HIST_LEN)).append([round(now, 1), g["util"], g["mem_pct"]])
        self.host_hist.append([round(now, 1), host["cpu"], host["mem_pct"]])
        with self.lock:
            self.state = {"t": now, "gpus": gpus, "host": host, "error": err}

    def run(self):
        while True:
            try:
                self.sample()
            except Exception as e:
                with self.lock:
                    self.state = dict(self.state, error=str(e))
            time.sleep(self.interval)

    def snapshot(self):
        with self.lock:
            s = dict(self.state)
            s["gpus"] = [dict(g, hist=list(self.hist.get(g["index"], []))) for g in s.get("gpus", [])]
            s["host"] = dict(s.get("host", {}), hist=list(self.host_hist))
        return s


def jobs_state(n_finished=30):
    """n_finished=None 返回全部任务 (含归档). 默认值保持旧行为 (jbmac 靠它判断任务结束)."""
    rows = [r for r in (job_row(j) for j in all_ids()) if r]
    if n_finished is not None:
        active = [r for r in rows if r["status"] in ACTIVE]
        rows = active + [r for r in rows if r["status"] not in ACTIVE][-n_finished:]
    rows = sorted(rows, key=lambda r: -r["id"])
    out = []
    for r in rows:
        p = r.pop("_p")
        r.update(rate=p.get("rate"), source=p.get("source"),
                 updated=p.get("updated"), cmd=(r["cmd"] or "").replace(os.path.expanduser("~"), "~"))
        out.append(r)
    return out


