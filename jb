def make_handler(sampler, token):
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def _send(self, code, body, ctype="application/json; charset=utf-8"):
            body = body.encode() if isinstance(body, str) else body
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def _auth(self, qs):
            if token:
                given = qs.get("token", [""])[0] or self.headers.get("X-Token", "")
                if not hmac.compare_digest(given, token):
                    self._send(401, "unauthorized: append ?token=...", "text/plain; charset=utf-8")
                    return False
            return True

        def do_POST(self):
            u = urllib.parse.urlparse(self.path)
            qs = urllib.parse.parse_qs(u.query)
            if not self._auth(qs):
                return
            # 防 CSRF / DNS rebinding: 必须带自定义头 (跨站请求会触发 CORS 预检而被拒), Host / Origin 必须是本机
            host = (self.headers.get("Host") or "").rsplit(":", 1)[0].strip("[]")
            origin = self.headers.get("Origin")
            if (self.headers.get("X-JB") != "1" or (not token and host not in ("127.0.0.1", "localhost", "::1"))
                    or (origin and urllib.parse.urlparse(origin).netloc != self.headers.get("Host"))):
                return self._send(403, '{"error":"forbidden"}')
            if not u.path.rstrip("/").endswith("/api/action"):
                return self._send(404, '{"error":"not found"}')
            try:
                body = json.loads(self.rfile.read(min(int(self.headers.get("Content-Length", 0)), 1 << 20)) or b"{}")
                op, ids = body["op"], [int(x) for x in body["ids"]]
            except (KeyError, ValueError, TypeError):
                return self._send(400, '{"error":"bad request"}')
            fns = {"rm": (op_rm,), "archive": (op_archive, True), "unarchive": (op_archive, False),
                   "group": (op_group, str(body.get("group") or "")[:64])}
            if op not in fns:
                return self._send(400, '{"error":"bad op"}')
            fn, *args = fns[op]
            res = []
            for jid in ids:
                try:
                    ok, msg = fn(jid, *args)
                except Exception as e:  # noqa: BLE001
                    ok, msg = False, str(e)
                res.append({"id": jid, "ok": ok, "msg": msg})
            return self._send(200, json.dumps({"results": res}, ensure_ascii=False))

        def do_GET(self):
            u = urllib.parse.urlparse(self.path)
            qs = urllib.parse.parse_qs(u.query)
            if not self._auth(qs):
                return
            path = u.path.rstrip("/").rsplit("/api/", 1)
            if len(path) == 1:
                return self._send(200, dashboard_html(), "text/html; charset=utf-8")
            if path[1] == "state":
                s = sampler.snapshot()
                s.update(cfg=load_cfg(), now=time.time())
                if qs.get("jobs", ["1"])[0] != "0":
                    s["jobs"] = jobs_state()
                return self._send(200, json.dumps(s, ensure_ascii=False))
            if path[1] == "jobs":
                return self._send(200, json.dumps({"jobs": jobs_state(None), "now": time.time()}, ensure_ascii=False))
            if path[1] == "log":
                try:
                    jid = int(qs["id"][0])
                    n = min(int(qs.get("n", ["300"])[0]), 5000)
                except (KeyError, ValueError):
                    return self._send(400, '{"error":"bad id"}')
                m = read_json(os.path.join(jdir(jid), "meta.json"))
                if m is None:
                    return self._send(404, '{"error":"no such job"}')
                return self._send(200, json.dumps({"id": jid, "status": status(m), "lines": tail_lines(m["log"], n)},
                                                  ensure_ascii=False))
            self._send(404, '{"error":"not found"}')

    return Handler


def cmd_serve(a):
    pidfile = os.path.join(HOME, "serve.pid")
    old = read_json(pidfile, {})
    if a.stop or a.status:
        alive = pid_alive(old.get("pid"), "serve")
        if a.status:
            print(f"dashboard 运行中: pid {old['pid']}  http://{old['host']}:{old['port']}/" if alive else "dashboard 未运行")
        elif alive:
            os.kill(old["pid"], signal.SIGTERM)
            print(f"已停止 dashboard (pid {old['pid']})")
        else:
            print("dashboard 未运行")
        return
    a.token = a.token or os.environ.get("JB_TOKEN") or None
    if a.daemon:
        if pid_alive(old.get("pid"), "serve"):
            sys.exit(f"jb: dashboard 已在运行 (pid {old['pid']}), 先 jb serve --stop")
        os.makedirs(HOME, exist_ok=True)
        args = [sys.executable, os.path.abspath(__file__), "serve", "--host", a.host, "--port", str(a.port),
                "--interval", str(a.interval)]
        env = dict(os.environ, JB_TOKEN=a.token or "")
        with open(os.path.join(HOME, "serve.log"), "ab") as lf:
            p = subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=lf, stderr=subprocess.STDOUT,
                                 start_new_session=True, env=env)
        write_json(pidfile, {"pid": p.pid, "host": a.host, "port": a.port})
        time.sleep(1)
        if p.poll() is not None:
            sys.exit(f"jb: dashboard 启动失败, 见 {os.path.join(HOME, 'serve.log')}")
        print(f"dashboard 已在后台启动: pid {p.pid}  http://{a.host}:{a.port}/" + ("?token=***" if a.token else ""))
        return
    a.token = a.token or os.environ.get("JB_TOKEN") or None
    if a.host not in ("127.0.0.1", "localhost") and not a.token:
        sys.exit("jb: 绑定非本地地址时必须设置 --token")
    sampler = Sampler(a.interval)
    sampler.sample()
    sampler.start()
    srv = ThreadingHTTPServer((a.host, a.port), make_handler(sampler, a.token))
    print(f"jb dashboard: http://{a.host}:{a.port}/", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


def main():
    if len(sys.argv) >= 3 and sys.argv[1] == "_run":
        return run_job(int(sys.argv[2]))
    ap = argparse.ArgumentParser(prog="jb", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="sub")

    s = sub.add_parser("submit", aliases=["sub", "run"], help="提交后台任务")
    s.add_argument("-n", "--name")
    s.add_argument("-g", "--gpu", help="如 0 或 0,1 或 cpu; 默认继承 CUDA_VISIBLE_DEVICES 或配置的 default_gpus")
    s.add_argument("-C", "--cwd", help="工作目录, 默认当前目录")
    s.add_argument("--total", type=float, help="总步数, 配合 --pattern 计算进度")
    s.add_argument("--pattern", help=f"提取已完成步数的正则 (第1组=done, 可选第2组=total), 默认 {DEFAULT_PATTERN}")
    s.add_argument("--after", help="等这些任务 (逗号分隔) 成功结束后再开始")
    s.add_argument("--after-any", action="store_true", help="依赖任务失败也照样开始")
    s.add_argument("--log", help="日志路径 (默认 ~/.jb/jobs/ID/out.log)")
    s.add_argument("--note", help="备注")
    s.add_argument("--force", action="store_true", help="允许使用不在 allowed_gpus 中的 GPU")
    s.add_argument("--no-check", action="store_true", help="不检查任务是否立即崩溃")
    s.add_argument("--notify", action="store_true", help="结束时一定推送 (忽略 min_seconds)")
    s.add_argument("--no-notify", action="store_true", help="结束时不推送")
    s.add_argument("-G", "--group", help="分组名")
    s.add_argument("cmd", nargs=argparse.REMAINDER)
    s.set_defaults(fn=cmd_submit)

    s = sub.add_parser("ls", aliases=["ps", "list"], help="列出任务")
    s.add_argument("-a", "--all", action="store_true", help="显示全部历史任务")
    s.add_argument("-n", type=int, default=8, help="额外显示最近 N 个已结束任务 (默认 8)")
    s.add_argument("-v", "--verbose", action="store_true", help="显示每个任务日志最后一行")
    s.add_argument("-G", "--group", help="只看该分组 (- 表示未分组), 含全部历史")
    s.add_argument("--archived", action="store_true", help="只看已归档")
    s.add_argument("-A", "--with-archived", action="store_true", help="同时显示已归档")
    s.add_argument("--json", action="store_true")
    s.set_defaults(fn=cmd_ls)

    s = sub.add_parser("show", aliases=["info"], help="任务详情")
    s.add_argument("id", type=int)
    s.add_argument("-n", type=int, default=15, help="日志尾部行数")
    s.set_defaults(fn=cmd_show)

    s = sub.add_parser("log", aliases=["logs", "tail"], help="查看日志")
    s.add_argument("id", type=int)
    s.add_argument("-n", type=int, default=40, help="行数, 0=全部")
    s.add_argument("-f", "--follow", action="store_true", help="持续输出直到任务结束")
    s.add_argument("--grep", help="只显示匹配正则的行")
    s.add_argument("--raw", action="store_true", help="原样输出 (不折叠 \\r)")
    s.set_defaults(fn=cmd_log)

    s = sub.add_parser("wait", help="等待任务结束")
    s.add_argument("ids", type=int, nargs="+")
    s.add_argument("--timeout", type=float, help="秒, 超时退出码 124")
    s.add_argument("--interval", type=float, default=5)
    s.add_argument("--tail", type=int, default=20, help="失败时打印的日志行数")
    s.set_defaults(fn=cmd_wait)

    s = sub.add_parser("kill", aliases=["stop", "cancel"], help="终止任务")
    s.add_argument("ids", type=int, nargs="+")
    s.add_argument("-9", "--hard", action="store_true", help="SIGKILL")
    s.set_defaults(fn=cmd_kill)

    s = sub.add_parser("retry", aliases=["rerun"], help="以相同参数重新提交")
    s.add_argument("id", type=int)
    s.add_argument("-g", "--gpu")
    s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_retry)

    s = sub.add_parser("gpu", help="GPU 占用")
    s.set_defaults(fn=cmd_gpu)

    s = sub.add_parser("serve", aliases=["web"], help="网页 dashboard")
    s.add_argument("--host", default="127.0.0.1")
    s.add_argument("--port", type=int, default=18765)
    s.add_argument("--token", help="访问口令 (也可用环境变量 JB_TOKEN); 绑定非本地地址时必须")
    s.add_argument("--interval", type=float, default=2.0, help="采样间隔秒")
    s.add_argument("-d", "--daemon", action="store_true", help="后台运行")
    s.add_argument("--stop", action="store_true", help="停止后台 dashboard")
    s.add_argument("--status", action="store_true")
    s.set_defaults(fn=cmd_serve)

    s = sub.add_parser("notify", help="配置任务结束推送 (微信/QQ/手机)")
    s.add_argument("action", choices=["show", "set", "test"], nargs="?", default="show")
    s.add_argument("key", nargs="?")
    s.add_argument("value", nargs="?")
    s.set_defaults(fn=cmd_notify)

    def selector(s):
        s.add_argument("ids", nargs="*", help="ID / 201-207 / 201,203")
        s.add_argument("-G", "--group", dest="sel_group", help="选中该分组的已结束任务 (- = 未分组)")
        s.add_argument("--match", help="选中名称匹配该正则的已结束任务")
        s.add_argument("--status", help="选中这些状态的已结束任务, 如 done,failed,killed")

    s = sub.add_parser("rm", help="删除任务记录 (含默认位置的日志)")
    selector(s)
    s.add_argument("-y", "--yes", action="store_true", help="用选择器时不再确认")
    s.set_defaults(fn=cmd_rm)

    for nm, hp in (("archive", "归档 (默认隐藏)"), ("unarchive", "取消归档")):
        s = sub.add_parser(nm, help=hp)
        selector(s)
        s.set_defaults(fn=cmd_archive)

    s = sub.add_parser("group", help="设置分组: jb group NAME ID ... (NAME 为 - 清除)")
    s.add_argument("name")
    selector(s)
    s.set_defaults(fn=cmd_group)

    s = sub.add_parser("groups", help="列出分组")
    s.set_defaults(fn=cmd_groups)

    s = sub.add_parser("clean", help="删除 N 天前结束的任务")
    s.add_argument("--days", type=float, default=14)
    s.set_defaults(fn=cmd_clean)

    a = ap.parse_args()
    if not a.sub:
        a = ap.parse_args(["ls"])
    a.fn(a)


if __name__ == "__main__":
    main()
