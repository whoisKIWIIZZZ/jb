def select_jobs(a):
    """显式 ID + (-G / --match / --status) 选择器; 返回 (ids, 是否用了选择器)."""
    ids = set(parse_ids(a.ids))
    use_sel = bool(a.sel_group or a.match or a.status)
    if use_sel:
        pat = re.compile(a.match) if a.match else None
        sts = set(a.status.split(",")) if a.status else None
        for jid in all_ids():
            m = read_json(os.path.join(jdir(jid), "meta.json"))
            if not m:
                continue
            st = status(m)
            if st in ACTIVE:
                continue
            if a.sel_group and (label(jid).get("group") or "") != ("" if a.sel_group == "-" else a.sel_group):
                continue
            if pat and not pat.search(m.get("name") or ""):
                continue
            if sts and st not in sts:
                continue
            ids.add(jid)
    if not ids:
        sys.exit("jb: 没有选中任何任务")
    return sorted(ids), use_sel


