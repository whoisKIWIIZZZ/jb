#!/usr/bin/env python3
"""jb - 轻量后台任务管理 (仅依赖标准库).

  jb submit [-n NAME] [-g 0,1|cpu] [--total N] [--after ID] -- CMD ...   提交后台任务
  jb ls [-a] [-v]          列出任务 (状态 / 进度 / ETA)
  jb show ID               任务详情 + 日志尾部
  jb log ID [-n 40] [-f]   查看日志
  jb wait ID ...           阻塞直到任务结束
  jb kill ID ...           终止任务
  jb retry ID              用相同参数重新提交
  jb gpu                   GPU 占用 + 对应任务
  jb notify set serverchan KEY   任务结束推送到微信 (还支持 pushplus/qmsg/bark/ntfy/webhook)
  jb serve -d              后台启动网页 dashboard (默认 127.0.0.1:18765)
  jb group NAME ID ...     给任务设分组 (NAME 为 - 时清除); jb groups 列出分组
  jb archive ID ...        归档 (jb ls / 面板默认隐藏); jb unarchive 取消
  jb rm ID ... / jb clean  删除任务记录

  ID 可写成 201 / 201-207 / 201,203; archive/unarchive/group/rm 还可用
  -G 分组 / --match 名称正则 / --status done,failed 批量选择 (只作用于已结束的任务).

进度识别 (优先级从高到低):
  1. 脚本打印 "[jb] progress 123/1000"
  2. submit 时给 --total N (+ 可选 --pattern, 默认匹配 "step 123")
  3. 日志中的 "step 12/100" "epoch 3/10" 之类
  4. tqdm 进度条
"""
