def _post(url, form=None, js=None, timeout=10):
    if js is not None:
        body, ctype = json.dumps(js, ensure_ascii=False).encode(), "application/json; charset=utf-8"
    else:
        body, ctype = urllib.parse.urlencode(form or {}).encode(), "application/x-www-form-urlencoded"
    req = urllib.request.Request(url, data=body, headers={"Content-Type": ctype, "User-Agent": "jb"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.read(300).decode(errors="replace")
    except urllib.error.HTTPError as e:
        body = e.read(300).decode(errors="replace")
        if body.lstrip().startswith("<"):
            body = "(HTML 页面, 多半是对方网站防火墙拦截)"
        raise RuntimeError(f"HTTP {e.code}: {body}") from None


def send_notify(ncfg, title, text, job=None):
    """按配置的渠道逐个发送, 返回 [(渠道, 结果或错误)]."""
    reqs = []  # (渠道, url, form, json); 全部当场求值, 避免闭包晚绑定
    short = "\n".join([title] + text.split("\n")[:3])
    if k := ncfg.get("serverchan"):
        mt = re.match(r"sctp(\d+)t", k)
        url = f"https://{mt[1]}.push.ft07.com/send/{k}.send" if mt else f"https://sctapi.ftqq.com/{k}.send"
        reqs.append(("serverchan", url, {"title": title[:32], "desp": f"```\n{text}\n```"}, None))
    if k := ncfg.get("pushplus"):
        reqs.append(("pushplus", "https://www.pushplus.plus/send", None,
                     {"token": k, "title": title, "content": text, "template": "txt"}))
    if k := ncfg.get("qmsg"):
        form = {"msg": f"{title}\n{text}"[:1800]}
        if ncfg.get("qmsg_group"):
            form["group"] = ncfg["qmsg_group"]
        reqs.append(("qmsg", f"https://qmsg.zendee.cn/v3/send/{k}", form, None))
        # Qmsg 的网站防火墙会拦截含 shell 片段 (引号/分号/重定向) 的消息, 被拦时退回只含状态的短消息
        reqs.append(("qmsg-short", f"https://qmsg.zendee.cn/v3/send/{k}", dict(form, msg=short), None))
    if k := ncfg.get("bark"):
        reqs.append(("bark", k.rstrip("/"), None, {"title": title, "body": text, "group": "jb"}))
    if k := ncfg.get("ntfy"):
        base, topic = k.rstrip("/").rsplit("/", 1)
        reqs.append(("ntfy", base, None, {"topic": topic, "title": title, "message": text, "tags": ["jb"]}))
    if k := ncfg.get("webhook"):
        reqs.append(("webhook", k, None, {"title": title, "text": text, "job": job}))
    results = []
    for name, url, form, js in reqs:
        if name == "qmsg-short" and not results[-1][1].startswith("ERROR HTTP 403"):
            continue
        if name == "qmsg-short":
            time.sleep(3.5)  # Qmsg 同一 key 3 秒限流
        for attempt in range(2):
            try:
                res = _post(url, form, js)
            except Exception as e:
                res = f"ERROR {e}"
            if not (name.startswith("qmsg") and "频率" in res):
                break
            time.sleep(3.5)  # 两个任务几乎同时结束时会撞上限流, 等一下重试
        results.append((name, res))
    return results


def job_message(m):
    st = status(m)
    p = progress(m["id"])
    title = f"[jb] #{m['id']} {m.get('name')} {ST_CN.get(st, st)}"
    lines = [f"状态: {st}" + (f" (rc={m['rc']})" if m.get("rc") not in (None, 0) else ""),
             f"用时: {fmt_dur(elapsed(m))}", f"主机: {socket.gethostname()}"]
    if p.get("done") is not None:
        lines.append(f"进度: {prog_str(p)}")
    if m.get("note"):
        lines.append(f"备注: {m['note']}")
    lines.append(f"命令: {m['cmd'][:200]}")
    if st != "done":
        lines += ["", "日志末尾:"] + [l[:200] for l in tail_lines(m["log"], 8)]
    elif p.get("last_line"):
        lines.append(f"最后输出: {p['last_line'][:200]}")
    return title, "\n".join(lines)


def maybe_notify(jid):
    ncfg = load_cfg().get("notify") or {}
    m = read_json(os.path.join(jdir(jid), "meta.json"))
    if not m or m.get("notify") is False or not any(ncfg.get(k) for k in ("serverchan", "pushplus", "qmsg", "bark", "ntfy", "webhook")):
        return
    st = status(m)
    on = ncfg.get("on", "done,failed,killed")
    on = on.split(",") if isinstance(on, str) else on
    if st not in on:
        return
    if m.get("notify") is not True and (elapsed(m) or 0) < float(ncfg.get("min_seconds", 60)):
        return
    title, text = job_message(m)
    for name, res in send_notify(ncfg, title, text, job={"id": jid, "name": m.get("name"), "status": st, "rc": m.get("rc")}):
        print(f"notify {name}: {res}", flush=True)


def cmd_notify(a):
    path = os.path.join(HOME, "config.json")
    c = read_json(path, {})
    ncfg = c.setdefault("notify", {})
    if a.action == "set":
        if not a.key or a.value is None:
            sys.exit("用法: jb notify set KEY VALUE   可用 KEY:\n" + "\n".join(f"  {k:12} {v}" for k, v in NOTIFY_KEYS.items()))
        if a.key not in NOTIFY_KEYS:
            sys.exit(f"jb: 未知 KEY {a.key}, 可用: {', '.join(NOTIFY_KEYS)}")
        if a.value == "":
            ncfg.pop(a.key, None)
        else:
            ncfg[a.key] = a.value
        os.makedirs(HOME, exist_ok=True)
        write_json(path, c)
        os.chmod(path, 0o600)
        print(f"已设置 notify.{a.key}")
    elif a.action == "show":
        if not ncfg:
            print("未配置推送渠道. jb notify set serverchan <SendKey> 等, 运行 jb notify set 查看可用 KEY")
        for k, v in ncfg.items():
            s = str(v)
            print(f"  {k:12} {s if k in ('min_seconds', 'on', 'qmsg_group') else s[:6] + '…' + s[-3:] if len(s) > 12 else '***'}")
    elif a.action == "test":
        res = send_notify(ncfg, "[jb] 测试推送", f"来自 {socket.gethostname()} 的测试消息\n{time.strftime('%F %T')}")
        if not res:
            print("未配置推送渠道")
        for name, r in res:
            print(f"{name}: {r}")


# ---------------------------------------------------------------- runner (detached)

def run_job(jid):
    d = jdir(jid)
    mpath = os.path.join(d, "meta.json")
    killed_flag = os.path.join(d, "killed")

    def finish(rc, **extra):
        m = read_json(mpath)
        m.update(end=time.time(), rc=rc, killed=os.path.exists(killed_flag), **extra)
        write_json(mpath, m)

    m = read_json(mpath)
    m["runner_pid"] = os.getpid()
    write_json(mpath, m)
    for dep in m.get("after", []):
        while True:
            if os.path.exists(killed_flag):
                return finish(None)
            dm = read_json(os.path.join(jdir(dep), "meta.json"))
            st = status(dm) if dm else "missing"
            if st not in ACTIVE:
                break
            time.sleep(3)
        if st != "done" and not m.get("after_any"):
            return finish(None, reason=f"依赖任务 {dep} 状态为 {st}")

    env = os.environ.copy()
    env.update(m.get("env", {}))
    env["PYTHONUNBUFFERED"] = "1"
    env["JB_JOB_ID"] = str(jid)
    os.makedirs(os.path.dirname(m["log"]) or ".", exist_ok=True)
    with open(m["log"], "ab") as log:
        p = subprocess.Popen(["bash", "-c", m["cmd"]], cwd=m["cwd"], env=env, stdin=subprocess.DEVNULL,
                             stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    m = read_json(mpath)
    m.update(start=time.time(), child_pid=p.pid)
    write_json(mpath, m)

    tracker = Tracker(jid, m)
    tick = 0
    while p.poll() is None:
        if tick % 5 == 0:
            tracker.update()
        tick += 1
        time.sleep(1)
    tracker.update()
    finish(p.returncode)
    maybe_notify(jid)


# ---------------------------------------------------------------- commands

def guess_name(cmd):
    toks = shlex.split(cmd) if cmd else []
    if "-m" in toks and toks.index("-m") + 1 < len(toks):
        return toks[toks.index("-m") + 1].rsplit(".", 1)[-1]
    for t in toks:
        if t.endswith((".py", ".sh")):
            return os.path.splitext(os.path.basename(t))[0]
    return os.path.basename(toks[0]) if toks else "job"


def git_rev(cwd):
    try:
        rev = subprocess.run(["git", "rev-parse", "--short", "HEAD"], cwd=cwd, capture_output=True,
                             text=True, timeout=3).stdout.strip()
        if not rev:
            return None
        dirty = subprocess.run(["git", "status", "--porcelain", "-uno"], cwd=cwd, capture_output=True,
                               text=True, timeout=5).stdout.strip()
        return rev + ("+dirty" if dirty else "")
    except Exception:
        return None


def parse_gpus(spec, force):
    """返回要设置的 CUDA_VISIBLE_DEVICES; None 表示不设置 (所有 GPU 可见)."""
    cfg = load_cfg()
    if spec is None:
        spec = os.environ.get("CUDA_VISIBLE_DEVICES", cfg.get("default_gpus"))
    if spec is None:
        return None
    spec = str(spec)
    if spec.lower() in ("cpu", "none", ""):
        return ""
    if not cfg.get("allowed_gpus"):
        return spec
    allowed = set(str(cfg["allowed_gpus"]).split(","))
    bad = [g for g in spec.split(",") if g not in allowed]
    if bad and not force:
        sys.exit(f"jb: GPU {','.join(bad)} 不在允许列表 {cfg['allowed_gpus']} 中 (用 --force 强制)")
    return spec


def gpu_env(gpus):
    return {} if gpus is None else {"CUDA_VISIBLE_DEVICES": gpus}


def gpu_label(m):
    g = m.get("env", {}).get("CUDA_VISIBLE_DEVICES")
    return "all" if g is None else g or "cpu"


def do_submit(spec, check=True):
    jid = new_id()
    d = jdir(jid)
    spec = dict(spec, id=jid, submitted=time.time())
    spec.setdefault("log", os.path.join(d, "out.log"))
    spec["name"] = spec.get("name") or guess_name(spec["cmd"])
    spec["git"] = git_rev(spec["cwd"])
    group = spec.pop("group", None)
    write_json(os.path.join(d, "meta.json"), spec)
    if group:
        set_label(jid, group=group)
    with open(os.path.join(d, "runner.log"), "ab") as rl:
        p = subprocess.Popen([sys.executable, os.path.abspath(__file__), "_run", str(jid)],
                             stdin=subprocess.DEVNULL, stdout=rl, stderr=subprocess.STDOUT,
                             start_new_session=True, cwd=spec["cwd"])
    gpu = gpu_label(spec) + (f" group={group}" if group else "")
    after = f" after={','.join(map(str, spec['after']))}" if spec.get("after") else ""
    print(f"job {jid} ({spec['name']}) 已提交  gpu={gpu}{after}")
    print(f"  log: {spec['log']}")
    if check and not spec.get("after"):
        for _ in range(6):
            time.sleep(0.5)
            if "end" in read_json(os.path.join(d, "meta.json")):
                break
        if p.poll() is not None and "end" not in read_json(os.path.join(d, "meta.json")):
            print(f"  !! runner 启动失败, 见 {os.path.join(d, 'runner.log')}")
        m = read_json(os.path.join(d, "meta.json"))
        st = status(m)
        if st not in ACTIVE:
            print(f"  !! 任务已立即结束: {color(st)} rc={m.get('rc')}")
            for line in tail_lines(spec["log"], 15):
                print("  | " + line)
    return jid


def cmd_submit(a):
    if not a.cmd:
        sys.exit("jb: 缺少命令, 用法: jb submit [opts] -- CMD ...")
    toks = a.cmd[1:] if a.cmd[0] == "--" else a.cmd
    cmd = toks[0] if len(toks) == 1 else shlex.join(toks)
    cwd = os.path.abspath(a.cwd or os.getcwd())
    spec = {
        "cmd": cmd, "cwd": cwd, "name": a.name, "note": a.note,
        "env": gpu_env(parse_gpus(a.gpu, a.force)),
        "total": a.total, "pattern": a.pattern,
        "after": [int(x) for x in a.after.split(",")] if a.after else [],
        "after_any": a.after_any,
        "notify": True if a.notify else False if a.no_notify else None,
        "group": a.group,
    }
    if a.log:
        spec["log"] = os.path.abspath(os.path.join(cwd, a.log))
    do_submit(spec, check=not a.no_check)


def job_row(jid):
