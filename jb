HOME = os.path.expanduser(os.environ.get("JB_HOME", "~/.jb"))
JOBS = os.path.join(HOME, "jobs")
DEFAULT_CFG = {"default_gpus": None, "allowed_gpus": None}  # None = 不限制, 在 ~/.jb/config.json 里覆盖
ACTIVE = ("queued", "running")


# ---------------------------------------------------------------- storage

def load_cfg():
    c = dict(DEFAULT_CFG)
    c.update(read_json(os.path.join(HOME, "config.json"), {}))
    return c


def jdir(jid):
    return os.path.join(JOBS, str(jid))


def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        return default


def write_json(path, obj):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(obj, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def all_ids():
    if not os.path.isdir(JOBS):
        return []
    return sorted(int(x) for x in os.listdir(JOBS) if x.isdigit())


def new_id():
    os.makedirs(JOBS, exist_ok=True)
    with open(os.path.join(HOME, "lock"), "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        counter = os.path.join(HOME, "next_id")
        try:
            jid = int(open(counter).read().strip())
        except (FileNotFoundError, ValueError):
            jid = 1
        ids = all_ids()
        jid = max(jid, ids[-1] + 1 if ids else 1)
        os.makedirs(jdir(jid))
        with open(counter, "w") as f:
            f.write(str(jid + 1))
    return jid


def meta(jid):
    m = read_json(os.path.join(jdir(jid), "meta.json"))
    if m is None:
        sys.exit(f"jb: 没有任务 {jid}")
    return m


def progress(jid):
    return read_json(os.path.join(jdir(jid), "progress.json"), {})


def label(jid):
    """分组 / 归档等标注, 单独存在 label.json, 不碰 runner 读写的 meta.json."""
    return read_json(os.path.join(jdir(jid), "label.json"), {}) or {}


def set_label(jid, **kw):
    path = os.path.join(jdir(jid), "label.json")
    lb = read_json(path, {}) or {}
    for k, v in kw.items():
        if v in (None, "", False):
            lb.pop(k, None)
        else:
            lb[k] = v
    write_json(path, lb)


def parse_ids(tokens):
    ids = []
    for tok in tokens or []:
        for part in str(tok).split(","):
            part = part.strip()
            if not part:
                continue
            mt = re.fullmatch(r"(\d+)\s*-\s*(\d+)", part)
            if mt:
                lo, hi = sorted((int(mt[1]), int(mt[2])))
                ids += range(lo, hi + 1)
            elif part.isdigit():
                ids.append(int(part))
            else:
                sys.exit(f"jb: 无法解析任务 ID {part!r}")
    return ids


def pid_alive(pid, must_contain=None):
    if not pid:
        return False
    try:
        with open(f"/proc/{pid}/stat") as f:
            if f.read().rsplit(")", 1)[1].split()[0] == "Z":
                return False
        if must_contain:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                return must_contain in f.read().decode(errors="replace").split("\0")
        return True
    except (FileNotFoundError, IndexError, ProcessLookupError):
        return False


def status(m):
    if "end" in m:
        if m.get("killed"):
            return "killed"
        if m.get("rc") is None:
            return "cancelled"
        return "done" if m["rc"] == 0 else "failed"
    if pid_alive(m.get("runner_pid"), str(m["id"])):
        return "running" if "start" in m else "queued"
    return "lost"


# ---------------------------------------------------------------- formatting

def fmt_dur(s):
    if s is None:
        return "-"
    s = int(max(0, s))
    d, s = divmod(s, 86400)
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    if d:
        return f"{d}d{h:02}h{m:02}m"
    return f"{h}:{m:02}:{s:02}" if h else f"{m}:{s:02}"


def fmt_time(t):
    return time.strftime("%m-%d %H:%M:%S", time.localtime(t)) if t else "-"


def fmt_num(x):
    return str(int(x)) if float(x).is_integer() else f"{x:.4g}"


COLORS = {"running": "32", "queued": "36", "done": "34", "failed": "31",
          "killed": "33", "cancelled": "33", "lost": "35"}


def color(st, text=None):
    text = st if text is None else text
    if not sys.stdout.isatty():
        return text
    return f"\033[{COLORS.get(st, '0')}m{text}\033[0m"


def elapsed(m):
    if "start" not in m:
        return None
    return m.get("end", time.time()) - m["start"]


def eta_now(m, st, p):
    if st != "running" or p.get("eta") is None:
        return None
    return max(0.0, p["eta"] - (time.time() - p["updated"]))


def prog_str(p):
    if not p.get("total"):
        return fmt_num(p["done"]) if p.get("done") is not None else "-"
    return f"{fmt_num(p['done'])}/{fmt_num(p['total'])} {100 * p['done'] / p['total']:.0f}%"


def render_cr(text):
    """把 tqdm 的 \\r 刷新折叠成每行最终状态."""
    out = []
    for line in text.split("\n"):
        segs = [s for s in line.split("\r") if s.strip()]
        out.append(segs[-1] if segs else line.replace("\r", ""))
    return out


def tail_lines(path, n, max_bytes=4 << 20):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - max_bytes))
            data = f.read().decode(errors="replace")
    except FileNotFoundError:
        return []
    lines = render_cr(data)
    if lines and lines[-1] == "":
        lines.pop()
    return lines[-n:] if n else lines


# ---------------------------------------------------------------- progress parsing

RE_EXPLICIT = re.compile(r"\[jb\]\s*progress\s*[:=]?\s*([\d.]+)\s*/\s*([\d.]+)", re.I)
RE_KEYWORD = re.compile(
    r"\b(?:global[_ ]?)?(?:step|epoch|iter|iteration|ep|batch|episode|round|trial|chunk)s?\b"
    r"\s*[:=#]?\s*(\d+)\s*/\s*(\d+)", re.I)
RE_TQDM = re.compile(r"(\d+)%\|[^|]*\|\s*([\d.]+[kMG]?)/([\d.]+[kMG]?)\s*\[([\d:]+)<([\d:?]+)")
DEFAULT_PATTERN = r"(?i)\bstep\b\s*[:=#]?\s*(\d+)"


def scaled(s):
    mult = {"k": 1e3, "M": 1e6, "G": 1e9}.get(s[-1])
    return float(s[:-1]) * mult if mult else float(s)


def hms(s):
    if "?" in s:
        return None
    sec = 0
    for part in s.split(":"):
        sec = sec * 60 + int(part)
    return sec


class Tracker:
    """在 runner 进程里增量读取日志, 解析进度, 估计速率与 ETA."""

    def __init__(self, jid, m):
        self.path_out = os.path.join(jdir(jid), "progress.json")
        self.log = m["log"]
        self.offset = 0
        self.carry = ""
        self.level = -1
        self.done = self.total = self.tqdm_eta = None
        self.source = None
        self.last_line = ""
        self.samples = deque(maxlen=2000)
        self.user_total = m.get("total")
        self.user_pat = re.compile(m.get("pattern") or DEFAULT_PATTERN) if self.user_total or m.get("pattern") else None

    def _accept(self, level, done, total, source, eta=None):
        if level < self.level:
            return
        self.level, self.done, self.total, self.source, self.tqdm_eta = level, done, total, source, eta

    def _parse(self, seg):
        if (mt := RE_EXPLICIT.search(seg)):
            self._accept(3, float(mt[1]), float(mt[2]), "jb")
            return
        if self.user_pat and (mt := self.user_pat.search(seg)):
            total = float(mt[2]) if mt.re.groups >= 2 and mt[2] else self.user_total
            self._accept(2, float(mt[1]), float(total) if total else None, "pattern")
            return
        if (mt := RE_KEYWORD.search(seg)):
            self._accept(1, float(mt[1]), float(mt[2]), "keyword")
            return
        if (mt := RE_TQDM.search(seg)):
            self._accept(0, scaled(mt[2]), scaled(mt[3]), "tqdm", hms(mt[5]))

    def update(self):
        try:
            with open(self.log, "rb") as f:
                f.seek(self.offset)
                data = f.read()
        except FileNotFoundError:
            return
        if not data:
            self._write()
            return
        self.offset += len(data)
        text = self.carry + data.decode(errors="replace")
        segs = re.split(r"[\r\n]", text)
        self.carry = segs[-1][-65536:]
        prev = self.done
        for seg in segs:
            if seg.strip():
                self._parse(seg)
                self.last_line = seg.strip()[:300]
        if self.done is not None and self.done != prev:
            if self.samples and self.done < self.samples[-1][1]:
                self.samples.clear()
            self.samples.append((time.time(), self.done))
        self._write()

    def _write(self):
        now = time.time()
        rate = eta = None
        if len(self.samples) >= 2:
            t1, d1 = self.samples[-1]
            t0, d0 = next(((t, d) for t, d in self.samples if t >= t1 - 900), self.samples[0])
            if (t0, d0) == (t1, d1):
                t0, d0 = self.samples[-2]
            if t1 > t0 and d1 > d0:
                rate = (d1 - d0) / (t1 - t0)
        if self.source == "tqdm" and self.tqdm_eta is not None:
            eta = self.tqdm_eta
        elif rate and self.total:
            eta = max(0.0, (self.total - self.done) / rate)
        write_json(self.path_out, {
            "done": self.done, "total": self.total, "source": self.source, "rate": rate,
            "eta": eta, "updated": now, "last_line": self.last_line,
        })


