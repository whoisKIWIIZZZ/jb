def cmd_log(a):
    m = meta(a.id)
    if a.raw and not a.follow:
        with open(m["log"], "rb") as f:
            shutil.copyfileobj(f, sys.stdout.buffer)
        return
    lines = tail_lines(m["log"], 0 if a.grep else a.n)
    if a.grep:
        pat = re.compile(a.grep)
        lines = [l for l in lines if pat.search(l)]
        lines = lines[-a.n:] if a.n else lines
    for line in lines:
        print(line)
    if not a.follow:
        return
    sys.stdout.flush()
    with open(m["log"], "rb") as f:
        f.seek(0, 2)
        try:
            while True:
                data = f.read()
                if data:
                    sys.stdout.buffer.write(data)
                    sys.stdout.flush()
                elif status(read_json(os.path.join(jdir(a.id), "meta.json"))) not in ACTIVE:
                    break
                else:
                    time.sleep(1)
        except KeyboardInterrupt:
            return
    m = meta(a.id)
    print(f"\n[jb] job {a.id} {status(m)} rc={m.get('rc')}")


def cmd_wait(a):
    pending = set(a.ids)
    deadline = time.time() + a.timeout if a.timeout else None
    ok = True
    while pending:
        for jid in sorted(pending):
            m = meta(jid)
            st = status(m)
            if st not in ACTIVE:
                pending.discard(jid)
                ok &= st == "done"
                print(f"job {jid} ({m.get('name')}) {st} rc={m.get('rc')} elapsed {fmt_dur(elapsed(m))}", flush=True)
                if st != "done":
                    for line in tail_lines(m["log"], a.tail):
                        print("  | " + line)
        if pending:
            if deadline and time.time() > deadline:
                print(f"jb: 超时, 仍在运行: {sorted(pending)}")
                sys.exit(124)
            time.sleep(a.interval)
    sys.exit(0 if ok else 1)


def cmd_kill(a):
    sig = signal.SIGKILL if a.hard else signal.SIGTERM
    for jid in a.ids:
        m = meta(jid)
        st = status(m)
        if st not in ACTIVE and st != "lost":
            print(f"job {jid} 已结束 ({st})")
            continue
        open(os.path.join(jdir(jid), "killed"), "w").close()
        if st == "running":
            try:
                os.killpg(m["child_pid"], sig)
            except ProcessLookupError:
                pass
            print(f"job {jid} 已发送 {sig.name}")
        elif st == "queued":
            print(f"job {jid} 已取消 (排队中)")
        else:
            m.update(end=time.time(), rc=None, killed=True)
            write_json(os.path.join(jdir(jid), "meta.json"), m)
            print(f"job {jid} (lost) 标记为 killed")


